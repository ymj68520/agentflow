{
  "kind": "agentflow.conformance.ace1-golden",
  "ace1_version": "1",
  "note": "Golden fixtures for ACE1 machine primitives. Value grammar: scalars are tagged objects ({\"int32\": \"-2147483648\"}); float64 input is the exact IEEE-754 bit pattern as 16 hex chars (negative-zero pattern included to prove canonicalization); bytes input is an array of byte values. expected_ace1_utf8 / expected_bytes_hex are frozen; tests must not regenerate them.",
  "cases": [
    {
      "case_id": "int32/zero",
      "description": "int32 zero",
      "shape": "int32",
      "value": {
        "int32": "0"
      },
      "expected_ace1_utf8": "\"0\"",
      "expected_bytes_hex": "223022"
    },
    {
      "case_id": "int32/one",
      "description": "int32 one",
      "shape": "int32",
      "value": {
        "int32": "1"
      },
      "expected_ace1_utf8": "\"1\"",
      "expected_bytes_hex": "223122"
    },
    {
      "case_id": "int32/negative-one",
      "description": "int32 negative one",
      "shape": "int32",
      "value": {
        "int32": "-1"
      },
      "expected_ace1_utf8": "\"-1\"",
      "expected_bytes_hex": "222d3122"
    },
    {
      "case_id": "int32/min",
      "description": "int32 minimum boundary",
      "shape": "int32",
      "value": {
        "int32": "-2147483648"
      },
      "expected_ace1_utf8": "\"-2147483648\"",
      "expected_bytes_hex": "222d3231343734383336343822"
    },
    {
      "case_id": "int32/max",
      "description": "int32 maximum boundary",
      "shape": "int32",
      "value": {
        "int32": "2147483647"
      },
      "expected_ace1_utf8": "\"2147483647\"",
      "expected_bytes_hex": "223231343734383336343722"
    },
    {
      "case_id": "int32/sample",
      "description": "int32 multi-digit sample",
      "shape": "int32",
      "value": {
        "int32": "123456789"
      },
      "expected_ace1_utf8": "\"123456789\"",
      "expected_bytes_hex": "2231323334353637383922"
    },
    {
      "case_id": "uint32/zero",
      "description": "zero uint32 value",
      "shape": "uint32",
      "value": {
        "uint32": "0"
      },
      "expected_ace1_utf8": "\"0\"",
      "expected_bytes_hex": "223022"
