            "field": "inner",
            "value": {
              "record": [
                {
                  "field": "x",
                  "value": {
                    "int64": "10"
                  }
                },
                {
                  "field": "y",
                  "value": {
                    "int64": "20"
                  }
                }
              ]
            }
          },
          {
            "field": "label",
            "value": {
