              "type": "float64"
            },
            {
              "field": "a_i32",
              "type": "int32"
            },
            {
              "field": "a_i64",
              "type": "int64"
            },
            {
              "field": "a_string",
              "type": "string"
            },
            {
              "field": "a_ts",
              "type": "timestamp"
            },
            {
