      "expected_bytes_hex": "7b2276616c7565223a6e756c6c7d"
    },
    {
      "case_id": "record/nested",
      "description": "nested records",
      "shape": {
        "record": {
          "name": "Outer",
          "fields": [
            {
              "field": "inner",
              "type": {
                "record": {
                  "name": "Point",
                  "fields": [
                    {
                      "field": "x",
                      "type": "int64"
                    },
                    {
                      "field": "y",
                      "type": "int64"
                    }
                  ]
                }
              }
            },
            {
              "field": "label",
              "type": "string"
