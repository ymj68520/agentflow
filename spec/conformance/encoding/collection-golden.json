{
  "kind": "agentflow.conformance.ace1-golden",
  "ace1_version": "1",
  "note": "Golden fixtures for ACE1 containers. Shape grammar: primitive names as strings; {\"enum\": {name, values}}, {\"list\": T}, {\"option\": T}, {\"map\": T}, {\"record\": {name, fields:[{field,type}]}}, {\"variant\": {name, cases:[{case,type}]}}. Record/map member order in canonical bytes is unsigned UTF-8 byte order of NFC names, independent of declaration or input order.",
  "cases": [
    {
      "case_id": "list/empty",
      "description": "empty list",
      "shape": {
        "list": "int32"
      },
      "value": {
        "list": []
      },
      "expected_ace1_utf8": "[]",
      "expected_bytes_hex": "5b5d"
    },
    {
      "case_id": "list/int32-order-preserved",
      "description": "list keeps order (not sorted)",
      "shape": {
        "list": "int32"
      },
      "value": {
        "list": [
          {
            "int32": "3"
          },
          {
            "int32": "1"
          },
          {
            "int32": "2"
          }
        ]
      },
      "expected_ace1_utf8": "[\"3\",\"1\",\"2\"]",
      "expected_bytes_hex": "5b2233222c2231222c2232225d"
    },
    {
      "case_id": "list/int32-boundaries",
      "description": "int32 boundaries in a list",
      "shape": {
        "list": "int32"
      },
      "value": {
        "list": [
          {
            "int32": "-2147483648"
          },
          {
            "int32": "2147483647"
          }
        ]
      },
      "expected_ace1_utf8": "[\"-2147483648\",\"2147483647\"]",
      "expected_bytes_hex": "5b222d32313437343833363438222c2232313437343833363437225d"
    },
    {
      "case_id": "list/string",
      "description": "list of strings",
      "shape": {
        "list": "string"
      },
      "value": {
        "list": [
          {
            "string": "b"
          },
          {
            "string": "a"
          },
          {
            "string": "c"
          }
        ]
      },
      "expected_ace1_utf8": "[\"b\",\"a\",\"c\"]",
      "expected_bytes_hex": "5b2262222c2261222c2263225d"
    },
    {
      "case_id": "list/nested",
      "description": "nested lists",
      "shape": {
        "list": {
          "list": "uint32"
        }
      },
      "value": {
        "list": [
          {
            "list": [
              {
                "uint32": "1"
              },
              {
                "uint32": "2"
              }
            ]
          },
          {
            "list": []
          }
        ]
      },
      "expected_ace1_utf8": "[[\"1\",\"2\"],[]]",
      "expected_bytes_hex": "5b5b2231222c2232225d2c5b5d5d"
    },
    {
      "case_id": "list/enum",
      "description": "list of closed enum values",
      "shape": {
        "list": {
          "enum": {
            "name": "TaskOutcome",
            "values": [
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "TIMED_OUT"
            ]
          }
        }
      },
      "value": {
        "list": [
          {
            "enum": "SUCCEEDED"
          },
          {
            "enum": "TIMED_OUT"
          }
        ]
      },
      "expected_ace1_utf8": "[\"SUCCEEDED\",\"TIMED_OUT\"]",
      "expected_bytes_hex": "5b22535543434545444544222c2254494d45445f4f5554225d"
    },
    {
      "case_id": "map/empty",
      "description": "empty map",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": []
      },
      "expected_ace1_utf8": "{}",
      "expected_bytes_hex": "7b7d"
    },
    {
      "case_id": "map/single",
      "description": "single-entry map",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "a",
            "value": {
              "int32": "1"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"a\":\"1\"}",
      "expected_bytes_hex": "7b2261223a2231227d"
    },
    {
      "case_id": "map/unsorted-input",
      "description": "unsorted input keys are canonicalized into byte order",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "zeta",
            "value": {
              "int32": "3"
            }
          },
          {
            "key": "alpha",
            "value": {
              "int32": "1"
            }
          },
          {
            "key": "mid",
            "value": {
              "int32": "2"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"alpha\":\"1\",\"mid\":\"2\",\"zeta\":\"3\"}",
      "expected_bytes_hex": "7b22616c706861223a2231222c226d6964223a2232222c227a657461223a2233227d"
    },
    {
      "case_id": "map/sorted-input-equivalent",
      "description": "the same map in sorted input order — bytes identical to map/unsorted-input",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "alpha",
            "value": {
              "int32": "1"
            }
          },
          {
            "key": "mid",
            "value": {
              "int32": "2"
            }
          },
          {
            "key": "zeta",
            "value": {
              "int32": "3"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"alpha\":\"1\",\"mid\":\"2\",\"zeta\":\"3\"}",
      "expected_bytes_hex": "7b22616c706861223a2231222c226d6964223a2232222c227a657461223a2233227d"
    },
    {
      "case_id": "map/byte-order-case",
      "description": "uppercase B (0x42) sorts before lowercase a (0x61)",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "a",
            "value": {
              "int32": "2"
            }
          },
          {
            "key": "B",
            "value": {
              "int32": "1"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"B\":\"1\",\"a\":\"2\"}",
      "expected_bytes_hex": "7b2242223a2231222c2261223a2232227d"
    },
    {
      "case_id": "map/byte-order-multibyte",
      "description": "multibyte keys sort by unsigned UTF-8 bytes: z(0x7A) < é(U+00E9) < 中(U+4E2D)",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "中",
            "value": {
              "int32": "3"
            }
          },
          {
            "key": "z",
            "value": {
              "int32": "1"
            }
          },
          {
            "key": "é",
            "value": {
              "int32": "2"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"z\":\"1\",\"é\":\"2\",\"中\":\"3\"}",
      "expected_bytes_hex": "7b227a223a2231222c22c3a9223a2232222c22e4b8ad223a2233227d"
    },
    {
      "case_id": "map/empty-key",
      "description": "empty string key sorts first",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "a",
            "value": {
              "int32": "2"
            }
          },
          {
            "key": "",
            "value": {
              "int32": "1"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"\":\"1\",\"a\":\"2\"}",
      "expected_bytes_hex": "7b22223a2231222c2261223a2232227d"
    },
    {
      "case_id": "map/key-needs-escaping",
      "description": "map key containing a quote",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "a\"b",
            "value": {
              "int32": "1"
            }
          },
          {
            "key": "ab",
            "value": {
              "int32": "2"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"a\\\"b\":\"1\",\"ab\":\"2\"}",
      "expected_bytes_hex": "7b22615c2262223a2231222c226162223a2232227d"
    },
    {
      "case_id": "map/nfc-key-input",
      "description": "decomposed key input is NFC-normalized",
      "shape": {
        "map": "int32"
      },
      "value": {
        "map": [
          {
            "key": "école",
            "value": {
              "int32": "1"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"école\":\"1\"}",
      "expected_bytes_hex": "7b22c3a9636f6c65223a2231227d"
    },
    {
      "case_id": "map/value-shapes",
      "description": "map<string,string> values",
      "shape": {
        "map": "string"
      },
      "value": {
        "map": [
          {
            "key": "b",
            "value": {
              "string": "second"
            }
          },
          {
            "key": "a",
            "value": {
              "string": "first"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"a\":\"first\",\"b\":\"second\"}",
      "expected_bytes_hex": "7b2261223a226669727374222c2262223a227365636f6e64227d"
    },
    {
      "case_id": "map/variant-values",
      "description": "map of variants",
      "shape": {
        "map": {
          "variant": {
            "name": "Result",
            "cases": [
              {
                "case": "ok",
                "type": "string"
              },
              {
                "case": "error",
                "type": "string"
              },
              {
                "case": "empty",
                "type": "unit"
              }
            ]
          }
        }
      },
      "value": {
        "map": [
          {
            "key": "a",
            "value": {
              "variant": {
                "case": "ok",
                "value": {
                  "string": "fine"
                }
              }
            }
          },
          {
            "key": "b",
            "value": {
              "variant": {
                "case": "empty",
                "value": {
                  "unit": null
                }
              }
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"a\":{\"ok\":\"fine\"},\"b\":{\"empty\":null}}",
      "expected_bytes_hex": "7b2261223a7b226f6b223a2266696e65227d2c2262223a7b22656d707479223a6e756c6c7d7d"
    },
    {
      "case_id": "record/declared-order-not-canonical",
      "description": "fields declared y,x are emitted in canonical byte order x,y",
      "shape": {
        "record": {
          "name": "Point",
          "fields": [
            {
              "field": "x",
              "type": "int64"
            },
            {
              "field": "y",
              "type": "int64"
            }
          ]
        }
      },
      "value": {
        "record": [
          {
            "field": "y",
            "value": {
              "int64": "2"
            }
          },
          {
            "field": "x",
            "value": {
              "int64": "1"
            }
          }
        ]
      },
      "expected_ace1_utf8": "{\"x\":\"1\",\"y\":\"2\"}",
      "expected_bytes_hex": "7b2278223a2231222c2279223a2232227d"
    },
    {
      "case_id": "record/empty",
