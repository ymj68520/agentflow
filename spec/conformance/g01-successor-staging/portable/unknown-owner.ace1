gnature@1","type_name":"UsageLimit"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"3fcb28eb8883dd88511504743f681fc054e96a649d616601c3cbc103cdd7c0ad"},"specification_id":"agentflow.usage.signature@1","type_name":"UsageMeterRef"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"8ca8abae3205561f6cc8dbbb4a4d0c00ccdd9e445b497e5c40cbce65bb945c5f"},"specification_id":"agentflow.usage.signature@1","type_name":"UsagePhase"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"1b4d60843ffe64ba7d036fee34185bb7063c658be4cd0804f122b6fd1b20e77e"},"specification_id":"agentflow.usage.signature@1","type_name":"UsageSignature"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"406cc5c6e8f96452cd601cce92bcfac97b8bea7db965a6628d8ad4bbd27a0840"},"specification_id":"agentflow.usage.signature@1","type_name":"UsageUpperBound"}]}},"role":"root_export"},{"declaration":{"model_missing":"not_formalized"},"role":"plan_lowering"},{"declaration":{"model_missing":"not_formalized"},"role":"runtime_semantics_profile"}],"static_identity_projection":{"analysis_semantics_version":"agentflow.root-export-checker@999","applied_rules":[{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0001","short_statement":"ComponentContract is a closed thirteen-field semantic body with exact imports and no arbitrary extension field.","source_anchor":"component-contract-closed-abi"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0002","short_statement":"Exact ComponentIdentity enters semantic identity while publication version and implementation metadata remain outside.","source_anchor":"component-contract-identity-digest"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0003","short_statement":"Only a validator-created checked body may be hashed with the existing component-contract HashV1 domain.","source_anchor":"component-contract-canonical-digest"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0004","short_statement":"Public I/O ports use independent positive namespaces and exact nominal TypeSchemaRef pins.","source_anchor":"component-contract-ports"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0005","short_statement":"The Failure row remains a separate exact-pinned proof dimension in the assembled contract.","source_anchor":"component-contract-cross-dimension"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0006","short_statement":"Effect operations and exact resource types require explicit complete relation coverage.","source_anchor":"component-contract-effect-resource"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0007","short_statement":"Effect selectors bind only to declared resource ports and exact mapped resource attributes.","source_anchor":"component-contract-effect-selector-mapping"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0008","short_statement":"Information-flow sources and sinks resolve in their exact input, resource and output namespaces.","source_anchor":"component-contract-flow-ports"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0009","short_statement":"Usage ceilings remain exact additive declarations and missing recovery coordinates are not zero.","source_anchor":"component-contract-recovery-usage"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0010","short_statement":"Recovery actions bind complete forward/action EffectAtom identities and form an acyclic dependency graph.","source_anchor":"component-contract-recovery-bindings"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0011","short_statement":"Execution constraints are resolved against explicit capability and profile universes.","source_anchor":"component-contract-execution"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0012","short_statement":"Unknown provenance or influence never establishes an unjustified positive flow proof.","source_anchor":"component-contract-flow-unknown"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0013","short_statement":"An effect selector requires a declared resource port, exact resource pin, full qualifier profile and closed operation support.","source_anchor":"component-contract-effect-resource-closure"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0014","short_statement":"EffectFlowPartitions retain full atom identity and only narrow an existing operation-level flow ceiling.","source_anchor":"component-contract-flow-partitions"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0015","short_statement":"Every required K action has exactly one exact ε binding and no undeclared action is accepted.","source_anchor":"component-contract-recovery-action-coverage"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0016","short_statement":"Recovery meter coverage is exhaustive and activation, attempt and usage bounds use checked arithmetic.","source_anchor":"component-contract-recovery-usage-checked"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0017","short_statement":"Any non-Proven required dimension prevents a Proven aggregate contract verdict.","source_anchor":"component-contract-proof-composition"},{"normative_source":"spec/component/relation-catalogs.md","rule_id":"AF-CONTRACT-0018","short_statement":"F/X relations match exact labels, taints, authority levels, flow kinds, sinks, regions and trust domains.","source_anchor":"flow-execution-catalog-exact-relations"},{"normative_source":"spec/component/relation-catalogs.md","rule_id":"AF-CONTRACT-0019","short_statement":"Proof context pins canonical relation content and changed snapshots invalidate prior proof results.","source_anchor":"component-relation-catalogs-snapshots"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0020","short_statement":"Substitution uses exact I/O pins and existing directional dimension proofs; unsupported refinements remain Unproven.","source_anchor":"component-contract-substitution"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0021","short_statement":"Static compatibility and relation proofs never create runtime authority, worker attestation or execution authorization.","source_anchor":"component-contract-static-authority-boundary"},{"normative_source":"spec/component/component-contract.md","rule_id":"AF-CONTRACT-0022","short_statement":"Each K action possibility must be contained by the exact declared action epsilon guard under frozen containment; a Violation requires a validator-created type-valid reachable countermodel, otherwise the relation remains Unproven, and no guard proof creates receipt eligibility.","source_anchor":"component-contract-recovery-action-guard"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0111","short_statement":"A component target resolves only by the complete exact digest pin in an explicit snapshot; identity comes from the checked contract, with no latest or name-only fallback.","source_anchor":"leaf-resolution-exact-pin"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0112","short_statement":"INVOKE requires a digest-recomputed CheckedComponentContract under the exact snapshot proof-context object; unresolved targets are never pure.","source_anchor":"leaf-resolution-checked-contract"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0113","short_statement":"Component input/output mappings require exact port numbers, exact public TypeSchemaRef pins, and existing Phase 3C scope, dominance, and producer proofs; local types are not public type evidence.","source_anchor":"leaf-resolution-public-port-types"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0114","short_statement":"Component resource ports map explicitly to visible ResourceSlotIds with exact resource type pins; absent attribute evidence remains Unproven and aliases never reduce bounds or grant authority.","source_anchor":"leaf-resolution-resource-ports"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0115","short_statement":"Scoped effects retain exact source contract, full atom qualifiers, bounds, caller digest and node identity; distinct call sites never merge by contract digest.","source_anchor":"leaf-resolution-effect-occurrences"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0116","short_statement":"Flow coordinates map only through exact I/O/R/effect mappings; unknown origins, influence, taints and authority bounds remain conservative and are never dropped or elevated.","source_anchor":"leaf-resolution-information-flow"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0117","short_statement":"Checked Failure/Effect/Flow/Usage/Recovery/Execution declarations remain per-invocation summaries; missing dimensions are not empty, and this phase performs no scaling or workflow placement closure.","source_anchor":"leaf-resolution-dimensions"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0118","short_statement":"CALL_SUBFLOW resolves its exact SemanticIrDigest in the Phase 3D universe and reuses the Phase 3D call-site interface checker.","source_anchor":"leaf-resolution-subflow-target"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0119","short_statement":"A subflow export requires a complete checked ComponentContract whose exact I/O/R pins match the derived target interface; derived I/O/R never synthesizes missing dimensions.","source_anchor":"leaf-resolution-subflow-export"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0120","short_statement":"Resolving a subflow export declaration does not prove body conformance; absent a trusted complete proof the relation remains RequiresEvidence.","source_anchor":"leaf-resolution-subflow-body-proof"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0121","short_statement":"The explicit exact-digest dependency closure fails closed on cycles and reports missing targets as Unproven without recursive expansion.","source_anchor":"leaf-resolution-subflow-closure"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0122","short_statement":"AWAIT preserves its exact signal pin and correlation while missing adapter dimensions remain partial; it has no implicit timeout, Effect dispatch, business cancellation failure, or authority uplift.","source_anchor":"leaf-resolution-await"},{"normative_source":"spec/computation/leaf-contract-resolution.md","rule_id":"AF-SEMANTIC-0123","short_statement":"ComponentContractDigest depends on canonical semantic body, not proof context; checked positive claims remain context-bound and must be revalidated after context change.","source_anchor":"leaf-resolution-digest-stability"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0124","short_statement":"A control result is a source-traceable non-wire DerivedControlContractSummary, never a CheckedComponentContract or digest input.","source_anchor":"control-summary-is-derived-only"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0125","short_statement":"Bottom-up traversal requires the exact current caller SemanticIrDigest, proof-context object, validator-created leaf summaries and Phase 3C evidence.","source_anchor":"control-context-and-leaves"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0126","short_statement":"Unknown or unsupported control operators remain Unproven; known descendants are not discarded and no row defaults empty. The formerly unsupported SCOPE and COMPENSATION_SCOPE now use the additive Phase 4B.2B.3 rules.","source_anchor":"control-unsupported-not-empty"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0127","short_statement":"SEQUENCE preserves semantic child order, uses existing Effect accumulation, weakens later-child lower bounds when prior success is not proven, and retains upper bounds/occurrences.","source_anchor":"control-sequence-effect"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0128","short_statement":"SELECT uses the frozen exclusive Effect branch_join and Usage maximum, retaining complete AtomKey qualifiers and guard-sensitive lower bounds.","source_anchor":"control-select-exclusive"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0129","short_statement":"SELECT totality is not invented without a default/range proof; selector dependencies remain decision influence and cannot elevate authority.","source_anchor":"control-select-coverage-and-influence"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0130","short_statement":"The frozen PARALLEL all mode accumulates every branch's possible Effect and Usage; max_inflight is concurrency only, and outputs use the explicit typed branch mapping.","source_anchor":"control-parallel-all"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0131","short_statement":"PARALLEL fail_fast retains sibling Effect/Usage/Failure facts despite cancellation and weakens lower bounds whose full execution is not guaranteed.","source_anchor":"control-parallel-fail-fast"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0132","short_statement":"RACE is FIRST_TERMINAL, not a SELECT join: all contestants including losers contribute Effect and Usage upper bounds, with only unguaranteed lower bounds weakened.","source_anchor":"control-race-effect-usage"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0133","short_statement":"RACE retains every contestant's exact Recovery/K and per-action Usage source facts, including losers; compensation never subtracts forward effects.","source_anchor":"control-race-recovery"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0134","short_statement":"Failure rows union across possible branches; cancellation/timeout are not typed business Failure, and static analysis never selects a physical winner or primary cause.","source_anchor":"control-race-outcome-flow"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0135","short_statement":"Control outputs reuse checked IR interfaces, Phase 3C producer evidence and explicit Parallel branch/port mapping; local types are not public schema aliases.","source_anchor":"control-typed-interface"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0136","short_statement":"Flow sources/taints union conservatively, may-carry authority takes its existing upper bound, unknown remains sticky, and selector/sequence/winner influence is not discarded.","source_anchor":"control-flow-may-influence"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0137","short_statement":"Usage uses checked accumulation or exclusive join by (phase,meter); missing coordinates remain Unknown, Forward/Recovery stay separate, and no retry/concurrency multiplier is inferred.","source_anchor":"control-usage-propagation"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0138","short_statement":"Recovery contracts, action identities and profiles remain per child; RACE losers do not lose declared recovery obligations.","source_anchor":"control-recovery-per-child"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0139","short_statement":"Resource ports stay source-scoped; numeric port equality never merges namespaces, and aliases require the exact same caller ResourceSlotId.","source_anchor":"control-resource-port-provenance"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0140","short_statement":"ExecutionRequirements remain per child and are not summed into a single Worker, placement, admission or capacity requirement.","source_anchor":"control-execution-per-child"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0141","short_statement":"Repeated uses of one contract remain distinct by caller digest, control/leaf node, contract digest and source ordinal even if the envelope algebra combines equal AtomKeys.","source_anchor":"control-occurrence-identity"},{"normative_source":"spec/computation/control-contract-algebra.md","rule_id":"AF-SEMANTIC-0142","short_statement":"Child Violation/Unproven/RequiresEvidence facts remain per-dimension obligations; a computed envelope cannot downgrade child evidence or be issued as a checked ComponentContract.","source_anchor":"control-proof-obligation-propagation"},{"normative_source":"spec/computation/advanced-control-contract-algebra.md","rule_id":"AF-SEMANTIC-0143","short_statement":"ITERATE uses conservative bounded repetition; dynamic FOREACH has no proven total count, max_inflight is not total work, and carry outputs require exact checked mapping.","source_anchor":"advanced-control-iterate-bounds"},{"normative_source":"spec/computation/advanced-control-contract-algebra.md","rule_id":"AF-SEMANTIC-0144","short_statement":"RETRY preserves ordered finite delays and separate physical-attempt bounds, conservatively amplifies logical Effect/Usage, and evaluates existing K without runtime evidence or inferred retry policy.","source_anchor":"advanced-control-retry-envelope-and-recovery"},{"normative_source":"spec/computation/advanced-control-contract-algebra.md","rule_id":"AF-SEMANTIC-0145","short_statement":"TIMEOUT preserves child contracts and represents child completion and TimedOut separately; timeout never proves successful cancellation or zero incurred Effect/Usage.","source_anchor":"advanced-control-timeout-outcomes"},{"normative_source":"spec/computation/advanced-control-contract-algebra.md","rule_id":"AF-SEMANTIC-0146","short_statement":"HANDLE matches exact Failure schema pins, preserves unmatched residual failures, keeps TimedOut outside Phi, and composes handler Effect/Usage as conditional alternatives.","source_anchor":"advanced-control-handle-residual"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0147","short_statement":"SCOPE compares exact Phase 3C parent, declared, and child ResourceSlot sets; child visibility is exactly the declared subset and does not imply a ResourceHandle or authorization.","source_anchor":"scope-resource-attenuation"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0148","short_statement":"SCOPE preserves child dimensions and ownership; missing authority/budget ceilings remain Unproven and child settlement before owner terminal RequiresEvidence.","source_anchor":"scope-static-obligations"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0149","short_statement":"COMPENSATION_SCOPE preserves Forward Effects, typed outcomes, and Forward Usage; potential compensation is additional and never refunds or rewrites the Forward history.","source_anchor":"compensation-forward-history"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0150","short_statement":"Only exact full RecoveryActionIdentity and RecoveryUsageBinding sources contribute; checked forward-occurrence, activation, and attempt bounds produce a conditional new Effect with zero lower bound, and the summed K upper must fit the exact declared action Effect occurrence.","source_anchor":"compensation-exact-action-envelope"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0151","short_statement":"Recovery Usage remains separate and is checked against potential action bounds; receipt eligibility and multi-event committed order require evidence, and RecoveryBlocked is not a business Failure.","source_anchor":"compensation-receipt-usage-and-order"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0152","short_statement":"Workflow-root derivation resolves all reachable leaves and accounts for every checked owned computation, known Effect occurrence/residual, and Recovery source exactly once in semantic order without promoting child obligations.","source_anchor":"workflow-control-tree-closure"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0153","short_statement":"A root derived summary is not an exported ComponentContract; without a frozen root pin and cross-coordinate mapping, export compatibility remains NotExpressedInSemanticIr and Unproven.","source_anchor":"workflow-root-export-boundary"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0154","short_statement":"Root Recovery closure compares the complete source, action-binding, forward-occurrence, and exact Usage-profile multisets; source-node coverage alone cannot prove action/profile accounting.","source_anchor":"root-recovery-source-closure"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0155","short_statement":"LocalActionBound and RootActionBound are distinct coordinates; exact caller/control-node/kind multiplicity identities are applied once with checked arithmetic and physical attempts are not multiplied twice.","source_anchor":"root-recovery-multiplicity"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0156","short_statement":"Root Recovery uses operator-specific Effect/Usage algebra, retains typed control-path and validator-created guard evidence separately, keeps both action kinds and RACE losers, and assigns each action to its nearest CompensationScope or typed RootRecovery owner.","source_anchor":"root-recovery-operator-algebra"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0157","short_statement":"The root K action projection, including a same-atom Forward opportunity exactly once, must fit the already derived root epsilon ceiling and is never added as a second epsilon declaration.","source_anchor":"root-recovery-epsilon-coverage"},{"normative_source":"spec/computation/scope-compensation-contract-algebra.md","rule_id":"AF-SEMANTIC-0158","short_statement":"Root K-required Recovery Usage must fit exact root U.recovery meter coordinates without double addition; missing active-source meters are not zero, overflow is a Violation, and runtime eligibility remains evidence-dependent.","source_anchor":"root-recovery-usage-coverage"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0159","short_statement":"The assertion pins the exact SemanticIrDigest and checked exported ComponentContractDigest.","source_anchor":"exact-assertion-pins"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0160","short_statement":"The proof-context manifest commits the complete typed static universes, relation content, and resolver pins.","source_anchor":"proof-context-manifest"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0161","short_statement":"Compiler semantics identity includes exact normative content, applied RuleIds, and checker semantics version.","source_anchor":"compiler-semantics-identity"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0162","short_statement":"Root inputs require a complete bijection to exported input ports with exact nominal types and checked use sites.","source_anchor":"root-input-mapping"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0163","short_statement":"Every exported output maps to an exact named WorkflowOutput with checked producer and nominal type evidence.","source_anchor":"root-output-mapping"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0164","short_statement":"Root resources map through exact ResourceSlot and exported requirement-port identities.","source_anchor":"root-resource-mapping"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0165","short_statement":"Possible root business failures are contained by the exact exported nominal failure row.","source_anchor":"failure-containment"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0166","short_statement":"Root effects and K action possibilities fit the exported epsilon ceiling after exact coordinate mapping.","source_anchor":"effect-containment"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0167","short_statement":"Root information flow does not relax the exported flow restrictions; unknown influence is retained.","source_anchor":"information-flow-non-relaxation"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0168","short_statement":"Root forward and recovery usage remain within separate exact exported phase, meter, unit, and bound coordinates.","source_anchor":"usage-containment"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0169","short_statement":"Root recovery sources, actions, profiles, and safety declarations are compared without invented enum ordering.","source_anchor":"recovery-compatibility"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0170","short_statement":"Every child execution source meets exported feasibility and security constraints independently.","source_anchor":"execution-compatibility"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0171","short_statement":"Subflow target pins do not prove implementation or body conformance.","source_anchor":"subflow-body-separation"},{"normative_source":"spec/computation/root-export-contract-proof.md","rule_id":"AF-SEMANTIC-0172","short_statement":"Static compatibility does not establish authority, budget reservation, or runtime authorization.","source_anchor":"static-runtime-boundary"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0173","short_statement":"The registered Bundle is a closed ten-field typed record; every member is required and IDs retain local namespaces.","source_anchor":"ppi-closed-schema"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0174","short_statement":"Portable machine scalars use exact ACE1 widths and representations; Int64 and Decimal never pass through binary floating point.","source_anchor":"ppi-exact-scalars"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0175","short_statement":"Required fields, None, Some(empty), Complete(empty) and Unavailable retain their distinct states.","source_anchor":"ppi-presence"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0176","short_statement":"Accepted bytes exactly equal schema-directed ACE1 re-encoding; decoders reject noncanonical input instead of repairing it.","source_anchor":"ppi-canonical-bytes"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0177","short_statement":"Declared sets use their registered typed order; duplicate values and conflicting identities fail at their specified stages.","source_anchor":"ppi-set-order"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0178","short_statement":"Local IDs resolve in their own table namespace and are never renumbered during decoding.","source_anchor":"ppi-scoped-ids"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0179","short_statement":"All required content is inline and each reference retains its digest domain and exact nominal schema pin.","source_anchor":"ppi-assets-inline"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0180","short_statement":"D2 resolves root-scoped references and rejects dangling, conflicting or unexplained transport rows.","source_anchor":"ppi-reference-closure"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0181","short_statement":"Structural-type and assertion graphs are bounded, finite and acyclic before expansion.","source_anchor":"ppi-finite-graphs"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0182","short_statement":"Resolver source, target, export and dependency associations retain their complete scoped typed identities.","source_anchor":"ppi-associations"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0183","short_statement":"Context and nested-universe member scopes are independent; D0-D4 never fills one scope from another.","source_anchor":"ppi-context-scopes"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0184","short_statement":"Schema assets use the existing canonical TypeSchema grammar and type-schema HashV1 domain.","source_anchor":"ppi-schema-content"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0185","short_statement":"IR and ComponentContract bytes use their existing exact canonical encodings and HashV1 domains; raw assets do not mint Checked wrappers.","source_anchor":"ppi-ir-contract-content"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0186","short_statement":"Registry, normative-source and other raw-file checksums are plain SHA-256 and are never confused with HashV1.","source_anchor":"ppi-checksum"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0187","short_statement":"Compiler inputs bind complete inline registries, closed tables and all referenced normative source bytes.","source_anchor":"ppi-source-registry"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0189","short_statement":"All ten semantic roles are represented and Lowering/Runtime remain ModelMissing in the static profile.","source_anchor":"ppi-role-boundary"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0191","short_statement":"Unknown or unsupported semantic content fails closed without implicit upcast or label substitution.","source_anchor":"ppi-no-upcast"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0192","short_statement":"D0-D4 output is raw content validation and cannot mint checked contract, IR, resolver or RootExport capabilities.","source_anchor":"ppi-no-capability"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0193","short_statement":"Decoder work and allocation limits yield ResourceLimit without truncation or partial positive results.","source_anchor":"ppi-resource-limits"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0194","short_statement":"Production bytes and stage results agree with an independent Python ACE1/schema oracle that does not consume Rust Actual results.","source_anchor":"ppi-independent-conformance"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0195","short_statement":"Portable registrations are additive; existing ABI meanings, schemas, HashV1 domains and frozen digests retain their identities.","source_anchor":"ppi-additive-freeze"},{"normative_source":"spec/portable/portable-proof-inputs.md","rule_id":"AF-SEMANTIC-0196","short_statement":"Comparator faults and malformed-input cases are separately detected by production conformance.","source_anchor":"ppi-mutation-evidence"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0197","short_statement":"Only a complete validator-origin fact roster may derive a full obligation view.","source_anchor":"g01-fact-authority"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0198","short_statement":"Scope retains complete compiler/context/resolver/root/assertion values and context-role partition.","source_anchor":"g01-exact-scope"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0199","short_statement":"Kind, clause, class, role and applicability must match the closed predicate roster.","source_anchor":"g01-closed-predicate"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0200","short_statement":"Source, target, coordinate and declared occurrence origin must be complete and consistent.","source_anchor":"g01-subject-origin"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0201","short_statement":"Each evaluated non-Proven fact yields exactly its disposition and typed obligation.","source_anchor":"g01-derive-nonproven"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0202","short_statement":"Failed core preflights block nine dimensions without inventing evaluations.","source_anchor":"g01-blocked-not-evaluated"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0203","short_statement":"Static proof eligibility requires five core checks and nine unique evaluated dimensions Proven.","source_anchor":"g01-five-plus-nine"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0204","short_statement":"Six root boundaries and each call-body requirement remain independent of static success.","source_anchor":"g01-independent-boundaries"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0205","short_statement":"Each known child retains distinct feasibility/security and source-coverage predicates.","source_anchor":"g01-child-execution-aspects"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0206","short_statement":"Prerequisites retain original predicate/stage/subject/origin and all consumer edges.","source_anchor":"g01-prerequisite-identity"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0207","short_statement":"A Proven predicate cannot have an unmet mandatory prerequisite or missing support.","source_anchor":"g01-prerequisite-consistency"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0208","short_statement":"References are complete typed evidence coordinates, not RuleIds or prose identities.","source_anchor":"g01-evidence-coordinate"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0209","short_statement":"Derived complete reference sets use the typed minimum except six root boundary primaries None.","source_anchor":"g01-primary-reference"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0210","short_statement":"Only equal originating facts merge observations; distinct origins stay distinct.","source_anchor":"g01-origin-copy-merge"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0211","short_statement":"Status, disposition, links, contradiction and observations remain required alongside identity.","source_anchor":"g01-status-preservation"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0212","short_statement":"The private successor constructor requires proof eligibility and successful complete bounded normalization.","source_anchor":"g01-private-capability-gate"},{"normative_source":"spec/computation/proof-obligation-semantics.md","rule_id":"AF-SEMANTIC-0213","short_statement":"Text, ordering, emptiness or successful serialization cannot create proof or runtime authority.","source_anchor":"g01-no-report-authority"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0214","short_statement":"Every semantic model type has exact closed field, width, option and variant descriptors.","source_anchor":"model-closed-descriptors"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0215","short_statement":"Sets and identity views use the registered typed total order, preserving semantic sequences.","source_anchor":"model-typed-order"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0216","short_statement":"Canonical identity strings are schema-directed ACE1 of the complete identity and decode bijectively.","source_anchor":"model-identity-ace1"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0217","short_statement":"Full scope is a finite minimal reachable typed value DAG with canonical bottom-up ranks.","source_anchor":"model-minimal-value-dag"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0218","short_statement":"Output/work/graph limits fail explicitly without truncated successful reports.","source_anchor":"model-no-partial-output"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0219","short_statement":"Unknown, missing, duplicate or noncanonical report fields/variants/identities are rejected without repair.","source_anchor":"model-closed-decode"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0220","short_statement":"Independent Expected compares every required typed field and canonical byte, not strings alone.","source_anchor":"model-independent-fullfield"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0221","short_statement":"Model identity/rank/derivation changes require new shape/obligation/content edition.","source_anchor":"model-shape-version"},{"normative_source":"spec/tables/proof-report-model-v1.md","rule_id":"AF-SEMANTIC-0222","short_statement":"Reason is diagnostic only after all equality/decision-bearing content is structurally retained.","source_anchor":"model-diagnostic-separation"},{"normative_source":"spec/portable/portable-proof-inputs-v2.md","rule_id":"AF-SEMANTIC-0228","short_statement":"Applied-rule attribution is explicit and does not claim complete dependency closure.","source_anchor":"edition-attribution-boundary"},{"normative_source":"spec/computation/proof-obligation-semantics-v2.md","rule_id":"AF-SEMANTIC-0229","short_statement":"Only the root_export profile has the five-core/nine-dimension CompleteView; standalone_substitution is a distinct non-root fragment and cannot issue RootExport capability.","source_anchor":"successor-profile-separation"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0230","short_statement":"The ordered old and replacement subjects retain all thirteen contract fields, exact canonical bytes and pins, actual validation provenance and complete context-role association without invented caller or resolver.","source_anchor":"substitution-subject"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0231","short_statement":"The standalone_substitution profile admits exactly its twenty-seven closed cases, twenty-six non-context clauses and twelve ordered result dimensions with the registered role and applicability mapping.","source_anchor":"substitution-roster"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0232","short_statement":"Complete catalog/name lineage equality is a local Proven or Unproven relation distinct from the final identity judgment; inequality is not Violation.","source_anchor":"substitution-lineage"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0233","short_statement":"Analysis aliases the replacement checked context and native context identity is mandatory; a failed association blocks all twelve comparisons without claiming evaluated relation failures.","source_anchor":"substitution-context"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0234","short_statement":"Context failure, exact-body reflexivity and changed-body comparison are disjoint branches; reflexivity never fabricates directional comparator execution.","source_anchor":"substitution-branches"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0235","short_statement":"Changed-body results retain the Unproven floor and all pre-arbitration candidates; the cross result folds eleven distinct non-cross results without a self dependency.","source_anchor":"substitution-result-fold"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0236","short_statement":"Execution feasibility and security remain distinct, combined execution preserves Unproven over Violation, and a shared comparison error does not invent three successful independent calls.","source_anchor":"substitution-execution"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0237","short_statement":"Usage and recovery preserve their exact frozen candidate rules, including the usage fallback without an added recovery-profile equality gate and no newly invented RequiresEvidence candidate.","source_anchor":"substitution-usage-recovery"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0238","short_statement":"Application origin binds the complete declarative document and real entry path; consumption premises are distinct from original validation facts and observations do not create origins.","source_anchor":"substitution-origin"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0239","short_statement":"Typed operand/member references, original-stage prerequisites, actual supporting facts and every consumer/observation edge are retained independently of RuleId and diagnostic text.","source_anchor":"substitution-reference-links"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0240","short_statement":"Every applicable fact retains its closed typed basis and each Violation its exact valid witness; unsupported lineage, effect, nominal-resource, influence, meter or binding relations are not upgraded to Violation.","source_anchor":"substitution-basis-witness"},{"normative_source":"spec/component/standalone-substitution-proof.md","rule_id":"AF-SEMANTIC-0241","short_statement":"Dependency errors use the complete domain-tagged finite frozen error-kind sets and full declared payload; unknown kinds are UnsupportedModel and missing required payload is IncompleteFacts.","source_anchor":"substitution-error-closure"},{"normative_source":"spec/tables/proof-report-model-v2.md","rule_id":"AF-SEMANTIC-0242","short_statement":"Every reachable successor descriptor has closed fields, variants, nominal widths, option presence, typed ordering and bounded DAG semantics; unknown types reject and no runtime reflection or new ACE1 grammar is permitted.","source_anchor":"successor-descriptor-closure"},{"normative_source":"spec/portable/portable-proof-inputs-v3.md","rule_id":"AF-SEMANTIC-0243","short_statement":"The distinct successor owner binds complete source, registry, descriptor, report and obligation identity; known label/content mismatches reject and old exact identities are never relabelled.","source_anchor":"successor-exact-identity"},{"normative_source":"spec/portable/portable-proof-inputs-v3.md","rule_id":"AF-SEMANTIC-0244","short_statement":"Registered, Supported and Activated are implementation-owned distinct states; incomplete successor producers, normalization or lossless scope cannot issue any RootExport Checked through direct, Portable or private construction paths.","source_anchor":"successor-staging-denial"}],"normative_specification_ids":["agentflow.component.contract.semantics@1","agentflow.component.relation-catalogs.semantics@1","agentflow.component.substitution-proof.semantics@1","agentflow.computation.proof-obligation.semantics@1","agentflow.computation.proof-obligation.semantics@2","agentflow.computation.proof-report.model@1","agentflow.computation.proof-report.model@2","agentflow.computation.root-export-contract-proof.semantics@1","agentflow.effect.signature.semantics@1","agentflow.execution.requirements.semantics@1","agentflow.failure.row.semantics@1","agentflow.information.flow.semantics@1","agentflow.portable.proof.inputs.semantics@1","agentflow.portable.proof.inputs.semantics@2","agentflow.portable.proof.inputs.semantics@3","agentflow.recovery.contract.semantics@1","agentflow.resource.requirement.semantics@1","agentflow.semantic.advanced-control-contract-algebra.semantics@1","agentflow.semantic.control-contract-algebra.semantics@1","agentflow.semantic.ir.semantics@1","agentflow.semantic.leaf-contract-resolution.semantics@1","agentflow.semantic.scope-compensation-contract-algebra.semantics@1","agentflow.semantic.types@1","agentflow.usage.signature.semantics@1"]}},"id":"1"}],"contract_assets":[{"canonical_content":"","reference":{"digest":{"algorithm":"sha256","domain":"component-contract","hex":"3e0e976f34fc0f636ef9d5908d944a16c86a09e588f108aa7d269c1357116be4"},"type_schema":{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"836dd3b654377c0c15774fb1a7abe84dc39038c01c56e8fe753d9c264374b299"},"specification_id":"agentflow.component.contract@1","type_name":"ComponentContract"}}}],"ir_assets":[{"canonical_content":"","reference":{"digest":{"algorithm":"sha256","domain":"semantic-ir","hex":"046eae2bd9fcc8338d2dba1d9511a316af44b7359ac01c056b494ddb17031e96"},"type_schema":{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"f6ca985ba7cccad128ed888a0f194433e113749d7ef548b2b0bd5f63e9f8467e"},"specification_id":"agentflow.semantic.ir@1","type_name":"SemanticIrDocument"}}}],"proof_contexts":[{"content":{"compiled_modules":{"complete":[{"named_types":[{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"836dd3b654377c0c15774fb1a7abe84dc39038c01c56e8fe753d9c264374b299"},"specification_id":"agentflow.component.contract@1","type_name":"ComponentContract"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"ece0ca539be0396328d1c9402c4ce6cac488aec9d77863cc3f23c35ed106eeb8"},"specification_id":"agentflow.component.contract@1","type_name":"ComponentIdentity"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"d35693981f2e92aaceb769009d5f00afadbbe133fc9326265f3a0523040cd289"},"specification_id":"agentflow.component.contract@1","type_name":"ComponentInputPort"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"4ec05b3c1b3524d99f37148b7e667ff8d2649ec13e978474565cb241c2ab9538"},"specification_id":"agentflow.component.contract@1","type_name":"ComponentOutputPort"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"3a2515df32a465228ee88bedc748863220874faf39cc823e11338e1f48800bf8"},"specification_id":"agentflow.component.contract@1","type_name":"EffectFlowPartition"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"5dfaa10ae034a6a016c5af1697145a3cadc44925ae1cdd2fe385b07e7dee0268"},"specification_id":"agentflow.component.contract@1","type_name":"RecoveryActionBinding"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"cbf949b29e2d147fcffdbbe86cb4b2df1b7a67237acd93effa14214baa692450"},"specification_id":"agentflow.component.contract@1","type_name":"RecoveryActionIdentity"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"563fafca90a0070e4f21da8551fdc5292910a958b025ef71a95faee971c1a89f"},"specification_id":"agentflow.component.contract@1","type_name":"RecoveryActionKind"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"2b84cd787471f0dfc34560ff01db47b8b23e44ed915a1e72236c0bb7ef9a508f"},"specification_id":"agentflow.component.contract@1","type_name":"RecoveryUsageBinding"}],"specification_id":"agentflow.component.contract@1"},{"named_types":[{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"96cf8f4e96fe7e20096501f1f949e199289a375c2ea0f6920891d6bd235dcedb"},"specification_id":"agentflow.core.machine-primitives@1","type_name":"Bool"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"2f9b835fce686273ea47f5ca5226f5386a7918e799b405d41c00b8174288bb23"},"specification_id":"agentflow.core.machine-primitives@1","type_name":"Bytes"},{"schema_digest":{"algorithm":"sha256","domain":"type-schema","hex":"307fc350a5400bbcde550edfb946301ac5c07dca8054a856d82ffec658cecbde"},"specification_id":"agentflow.core.mach