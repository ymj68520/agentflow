afidl 1;

schema agentflow.recovery.contract @1;

import agentflow.effect.signature @1 as effect;

// Static Recovery Contract K. This module declares replay, idempotency,
// reconciliation and compensation obligations. It does not represent a
// receipt, provider result, runtime state, grant, key, journal position or
// executable compensation.
//
// Invocation != Attempt; Recovery Replay != Historical Replay != Fork;
// Idempotency Declaration != Idempotency Proof; Compensation never erases
// forward effect history. Unknown and partially-applied runtime states are
// future evidence values and are not generated by this wire model.

enum ReplaySemantics {
    1 recompute;
    2 recorded;
    3 reconcile;
    4 forbidden;
}

enum IdempotencySemantics {
    1 natural;
    2 keyed;
    3 none;
    4 reconciled;
}

record KeyStabilityRequirement {
    1 stable_across_attempts: bool;
    2 distinct_across_invocations: bool;
    3 bound_to_operation: bool;
    4 provider_honors: bool;
}

enum ReconciliationRequirement {
    1 none;
    2 required;
}

variant CompensationRequirement {
    1 none: unit;
    2 required: effect.EffectOperationRef;
}

enum UnknownEffectHandling {
    1 block;
    2 reconciliation_required;
}

record EffectRecoveryClause {
    1 effect: effect.EffectAtom;
    2 idempotency: IdempotencySemantics;
    3 key_requirement: option<KeyStabilityRequirement>;
    4 reconciliation: ReconciliationRequirement;
    5 compensation: CompensationRequirement;
    6 unknown_effect_handling: UnknownEffectHandling;
}

record RecoveryContract {
    1 replay_semantics: ReplaySemantics;
    2 effect_recovery_clauses: list<EffectRecoveryClause>;
}
