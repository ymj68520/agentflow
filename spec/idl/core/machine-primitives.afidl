afidl 1;

schema agentflow.core.machine-primitives @1;

// AgentFlow machine primitive universe — AFIDL1 builtin registry.
//
// The 13 primitives below are builtin TypeExprs of the AFIDL1 language
// (spec/idl/afidl1-grammar.md, spec/tables/afidl-primitives.json). They are
// NOT user-declared types: TypeExpr positions reference them directly as
// keywords. Each alias in this module binds a nominal schema name to the
// corresponding builtin primitive so this file is a real, parseable AFIDL1
// module; alias identity is deliberately distinct from primitive identity
// (nominal distinction, consistent with unit/null and timestamp/int64).
//
// This file is the source of truth for the builtin universe: conformance
// tests parse it and drift-check the alias target set against the Rust
// Primitive enum and the closed JSON table.

alias Unit = unit;
alias Null = null;
alias Bool = bool;
alias Int32 = int32;
alias UInt32 = uint32;
alias Int64 = int64;
alias UInt64 = uint64;
alias Decimal = decimal;
alias Float64 = float64;
alias String = string;
alias Bytes = bytes;
alias Timestamp = timestamp;
alias Duration = duration;
